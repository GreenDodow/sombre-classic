<form class="sombre-sheet antagonist">
  <header class="sheet-header antagonist-header">
    <div class="nameContainer">
      <label for="name" class="name-label section-label">NOM</label>
      <input id="name" class="char-name" type="text" name="name" value="{{actor.name}}" title="{{actor.name}}"
      placeholder="Nom du personnage" />
    </div>
      <div class="portraitContainer">
            <img class="portrait antagonist-portrait" src="{{actor.img}}" data-edit="img" alt="portrait" />
      </div>
  </header>
  
  <section id="theat-section" class="section threat">
    <label for="threat-section" class="threat-label">NIVEAU DE MENACE</label>
  <select name="system.attributes.Danger">
  <option value="1" {{#if (eq system.attributes.Danger 1)}}selected{{/if}} title='Les laquets ont un nombre de dégâts maximum défini et leurs jets se font en fonction de leurs caractéristiques'>Laquet ({{system.attributes.MaxDammages}})</option>
  <option value="2" {{#if (eq system.attributes.Danger 2)}}selected{{/if}} title='Les boss peuvent infliger des dégats variables comme les pj mais ils réalisent leurs jets sous leur maximum, quelles que soient leurs caractéristiques'>Boss</option>
</select>
  </section>

<label for="stat-section" class="section-label">CARACTERISTIQUES</label>
  <section id="stat-section" class="stats section">
    
      <div class="radio-container">
