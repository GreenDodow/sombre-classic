        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-5"
            name="system.attributes.Esprit" value="5" {{checked (eq system.attributes.Esprit 5)}}/>
          <label class="radio-label" for="spirit-5">05</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-4" name="system.attributes.Corps"
            value="4" {{checked (eq system.attributes.Corps 4)}} />
          <label class="radio-label" for="body-4">Mutilé </br> - </br> 04</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-4"
            name="system.attributes.Esprit" value="4" {{checked (eq system.attributes.Esprit 4)}}/>
          <label class="radio-label" for="spirit-4">Désaxé </br> - </br> 04</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-3" name="system.attributes.Corps"
