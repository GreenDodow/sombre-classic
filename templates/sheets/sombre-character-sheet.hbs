        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-2"
            name="system.attributes.Esprit" value="2" {{checked (eq system.attributes.Esprit 2)}}/>
          <label class="radio-label" for="spirit-2">02</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-1" name="system.attributes.Corps"
            value="1" {{checked (eq system.attributes.Corps 1)}} />
          <label class="radio-label" for="body-1">01</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-1"
            name="system.attributes.Esprit" value="1" {{checked (eq system.attributes.Esprit 1)}}/>
          <label class="radio-label" for="spirit-1">01</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-0" name="system.attributes.Corps"
            value="0" {{checked (eq system.attributes.Corps 0)}} />
          <label class="radio-label" for="body-0">Mort </br> - </br> 0</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-0"
            name="system.attributes.Esprit" value="0" {{checked (eq system.attributes.Esprit 0)}}/>
          <label class="radio-label" for="spirit-0">Fou </br> - </br> 0</label>
        </div>
      </div>
  </section>
<div class="adrenaline">
  <label title="Les points sont utilisables via le bouton corps">Adrénaline</label>
  <div class="dots">
    <div class="dot {{adrenaline1}}"></div>
    <div class="dot {{adrenaline2}}"></div>
    <div class="dot {{adrenaline3}}"></div>
    <button type="button" class="resources-reset" title="Restaurer vos ressources">
       <span class="plus-icon">+</span>
    </button>
    {{#if (eq system.attributes.Desavantage "Cardiaque")}}
    <div class="heart-container">
  <svg class="heart-bolt" data-index="1" viewBox="0 0 100 100">
    <path class="heart-shape"
      d="M50 85 L20 55 A20 20 0 0 1 50 25 A20 20 0 0 1 80 55 Z"/>
    <path class="bolt-shape"
      d="M48 30 L35 55 H48 L42 75 L65 45 H52 Z"/>
  </svg>
</div>
{{/if}}
  </div>
</div>
  <!-- ÉTAT -->
  <label for="personnality-section" class="section-label">PERSONNALITE</label>
  <section class="personnality section">
    <div class="personnalitySelects">
      <div class="selectContainer">
<label>Avantage</label>
    <select name="system.attributes.Avantage" class="personnalitySelect">
  {{#each positivesTraitsNames}}
    <option title="{{this.trait.Description}}" value="{{this.trait.Name}}"
      {{#if (eq this.trait.Name ../system.attributes.Avantage)}}selected{{/if}}>
      {{this.trait.Name}}
    </option>
  {{/each}}
</select>
      </div>
      
<div class="selectContainer">
<label>Désavantage</label>
<select name="system.attributes.Desavantage" class="personnalitySelect">
  {{#each negativesTraitsNames}}
    <option title="{{this.trait.Description}}" value="{{this.trait.Name}}"
      {{#if (eq this.trait.Name ../system.attributes.Desavantage)}}selected{{/if}}>
      {{this.trait.Name}}
    </option>
  {{/each}}
</select>
</div>

<div class="selectContainer">
<label>Personnalité</label>
<select name="system.attributes.Personnality" class="personnalitySelect">
  {{#each personnalitiesNames}}
    <option value="{{this.name}}"
      {{#if (eq this.name ../system.attributes.Personnality)}}selected{{/if}}>
      {{this.name}}
    </option>
  {{/each}}
</select>
</div>

</div>
<div>
  <p class="personnalityDesc" >
    {{personnalityDesc}}
  </p>
</div>
 {{#if (eq system.attributes.Desavantage "Bipolaire")}}
 <div class="selectContainer second-personnality">
<label>Personnalité secondaire</label>
<select name="system.attributes.SecondPersonnality" class="personnalitySelect">
  {{#each secondPersonnalitiesNames}}
    <option value="{{this.name}}"
      {{#if (eq this.name ../system.attributes.SecondPersonnality)}}selected{{/if}}>
      {{this.name}}
    </option>
  {{/each}}
</select>
</div>


<div>
<p class="personnalityDesc" >
    {{secondPersonnalityDesc}}
  </p>
</div>
  
  {{/if}}



  </section>
 </div>
 <div class="tab" data-group="secondary" data-tab="mental">
  <div class="inventory-container">
  <label class="section-label">BIOGRAPHIE</label>

  <textarea
    name="system.attributes.biography"
    class="inventory-textarea"
    placeholder="Décris ici le vécu de ton personnage."
  >{{system.attributes.biography}}</textarea>
</div>
  <div class="inventory-container">
  <label class="section-label">INVENTAIRE</label>

  <textarea
    name="system.inventory"
    class="inventory-textarea"
    placeholder="Décris ici l’équipement, les objets, les notes d’inventaire..."
  >{{system.resources.inventory}}</textarea>
</div>

 </div>
  </section>

</form>