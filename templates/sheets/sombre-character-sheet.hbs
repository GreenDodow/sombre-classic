          <label class="radio-label" for="body-8">Blessé </br> - </br> 08</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-8"
            name="system.attributes.Esprit" value="8" {{checked (eq system.attributes.Esprit 8)}}/>
          <label class="radio-label" for="spirit-8">Perturbé </br> - </br> 08</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-7" name="system.attributes.Corps"
            value="7" {{checked (eq system.attributes.Corps 7)}} />
          <label class="radio-label" for="body-7">07</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-7"
            name="system.attributes.Esprit" value="7" {{checked (eq system.attributes.Esprit 7)}}/>
          <label class="radio-label" for="spirit-7">07</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-6" name="system.attributes.Corps"
            value="6" {{checked (eq system.attributes.Corps 6)}} />
          <label class="radio-label" for="body-6">06</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-6"
            name="system.attributes.Esprit" value="6" {{checked (eq system.attributes.Esprit 6)}}/>
          <label class="radio-label" for="spirit-6">06</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-5" name="system.attributes.Corps"
