<form class="sombre-sheet">
<nav class="sheet-tabs tabs sombre-tabs" data-group="secondary">
  <a class="item active" data-tab="stats">Caractéristiques</a>
  <a class="item" data-tab="mental">Bio/Inventaire</a>
</nav>

  <!-- HEADER -->
  <header class="sheet-header">
    <div class="nameContainer">
      <label for="name" class="name-label section-label">NOM</label>
      <input id="name" class="char-name" type="text" name="name" value="{{actor.name}}" title="{{actor.name}}"
      placeholder="Nom du personnage" />
    </div>
   
      <div class="portraitContainer">
            <img class="portrait" src="{{actor.img}}" data-edit="img" alt="portrait" />
      </div>
  </header>
 <section class="sheet-body">
 <div class="tab active" data-group="secondary" data-tab="stats">
  <!-- STATS -->
  <label for="stat-section" class="section-label">CARACTERISTIQUES</label>
  <section id="stat-section" class="stats section">
    
      <div class="radio-container">
        <div class="inner-container label-container">
          <button type="button" class="roll-corps rollButton body-label stat-label" title="Effectuer un test de corps">CORPS</button>
        </div>
        <div class="inner-container label-container">
          <button type="button" class="roll-esprit rollButton spirit-label stat-label" title="Effectuer un test d'esprit">ESPRIT</button>
        </div>
      </div>   
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-12" name="system.attributes.Corps" value="12" checked
            {{checked (eq system.attributes.Corps 12)}} />
          <label class="radio-label" for="body-12">Indemne </br> - </br> 12</label>
        </div>
        <div class="inner-container">
          <div class="radio-container"><input type="radio" class="radio-input" id="spirit-12"
              name="system.attributes.Esprit" value="12" checked  {{checked (eq system.attributes.Esprit 12)}} />
            <label class="radio-label" for="spirit-12">Equilibré </br> - </br>  12</label>
          </div>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-11" name="system.attributes.Corps"
            value="11" {{checked (eq system.attributes.Corps 11)}} />
          <label class="radio-label" for="body-11">11</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-11"
            name="system.attributes.Esprit" value="11"{{checked (eq system.attributes.Esprit 11)}} />
          <label class="radio-label" for="spirit-11">11</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-10" name="system.attributes.Corps"
            value="10" {{checked (eq system.attributes.Corps 10)}} />
          <label class="radio-label" for="body-10">10</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-10"
            name="system.attributes.Esprit" value="10" {{checked (eq system.attributes.Esprit 10)}}/>
          <label class="radio-label" for="spirit-10">10</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-9" name="system.attributes.Corps"
            value="9" {{checked (eq system.attributes.Corps 9)}} />
          <label class="radio-label" for="body-9">09</label>
        </div>
        <div class="inner-container">
          <input type="radio" class="radio-input" id="spirit-9"
            name="system.attributes.Esprit" value="9" {{checked (eq system.attributes.Esprit 9)}}/>
          <label class="radio-label" for="spirit-9">09</label>
        </div>
      </div>
      <div class="radio-container">
        <div class="inner-container">
          <input type="radio" class="radio-input" id="body-8" name="system.attributes.Corps"
